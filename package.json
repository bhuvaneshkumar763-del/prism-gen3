{
  "name": "prism-gen3",
  "description": "Prism — AI Page Translator (Gen 3, ground-up rewrite)",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "safari:sync": "npm run build:safari && node scripts/sync-safari.mjs",
    "compile": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:replay": "node tests/replay/run.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "replay:record": "node tests/replay/record.mjs",
    "guard:engine-purity": "node scripts/check-engine-purity.mjs",
    "guard:solid-reactivity": "node scripts/check-solid-reactivity.mjs",
    "guard:bundle-size": "node scripts/check-bundle-size.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.1",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-solid": "^1.1.4",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5",
    "web-ext": "10.8.0",
    "wxt": "^0.21.5"
  }
}
