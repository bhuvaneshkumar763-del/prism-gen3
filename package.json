{
  "name": "prism-gen3",
  "description": "Prism — AI Page Translator (Gen 3, ground-up rewrite)",
  "private": true,
  "version": "0.3.0-beta.68",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "safari:sync": "npm run build:safari && node scripts/sync-safari.mjs",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/run.mjs",
    "guard:engine-purity": "node scripts/check-engine-purity.mjs",
    "guard:solid-reactivity": "node scripts/check-solid-reactivity.mjs",
    "guard:bundle-size": "node scripts/check-bundle-size.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/module-solid": "^1.1.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
